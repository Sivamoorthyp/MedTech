# ──────────────────────────────────────────────────────────
# MindPulse API — Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit .env to git!
# ──────────────────────────────────────────────────────────

# ── Server ──
HOST=127.0.0.1
PORT=8001

# ── Database (Supabase PostgreSQL) ──
# Use asyncpg driver: postgresql+asyncpg://user:password@host:port/dbname
# Special characters in password must be URL-encoded (e.g. @ → %40)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD_URL_ENCODED@db.YOUR_PROJECT_ID.supabase.co:5432/postgres

# ── AI — Groq (fallback LLM) ──
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── AI — Ollama (primary: Aria fine-tuned model) ──
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=aria

# ── Admin ──
ADMIN_SECRET=your_strong_admin_secret_here
